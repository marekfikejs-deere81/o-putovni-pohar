# Názvy proměnných. Hodnoty NIKDY nedávej do Gitu ani do chatu.

# --- Frontend (veřejné, GitHub → Settings → Variables) ---
PUBLIC_API_BASE=            # např. https://putovni-pohar-api.<ucet>.workers.dev

# --- Cloudflare Worker Secrets (wrangler secret put …) ---
DATABASE_URL=               # běhová role Neon (jen potřebné granty)
NEON_AUTH_JWKS_URL=         # klíče pro ověření přihlašovacího tokenu
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=       # šifrování obnovovacího tokenu Gmailu
ALLOWED_ORIGINS=            # https://marekfikejs-deere81.github.io
MAIL_MODE=test              # test | live – v testu jen na testovací příjemce
MAIL_TEST_RECIPIENTS=

# --- CI (GitHub Secrets) ---
DATABASE_URL_MIGRATIONS=    # vlastník schématu pro migrace
CLOUDFLARE_API_TOKEN=       # jen Workers:Edit pro nasazení
